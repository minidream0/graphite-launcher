{
  "name": "graphite-launcher",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File BUILD-RUST.ps1 -Run",
    "test": "node --test src/poll.test.js src/icon-catalog.test.js src/operations.test.js src/operation-motion.test.js src/server-form.test.js src/theme.test.js",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File BUILD-RUST.ps1",
    "test:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File BUILD-RUST.ps1 -Test"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  },
  "description": "Graphite desktop: Rust, system WebView2, React/Tailwind and Prism C++"
}
